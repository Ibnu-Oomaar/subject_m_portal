# Copy to .env and adjust. Bun loads .env automatically.
NODE_ENV=development
PORT=3000

# PostgreSQL (TypeORM)
DATABASE_URL=postgresql://neondb_owner:npg_qeuYRrpvOi65@ep-lucky-cherry-be627zdz-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_LOGGING=false


# Browser origin(s) that serve the frontend (comma separated). Used for Origin checks (CSRF) and Socket.IO CORS.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://subject-m-portal.vercel.app

# Number of reverse-proxy hops in front of the API (0 = none). Needed so rate limiting sees real client IPs.
TRUST_PROXY=0

# Cookies. COOKIE_SECURE defaults to true in production, false otherwise.
SESSION_COOKIE_NAME=mp_sid
# COOKIE_SECURE=true
TEACHER_SESSION_IDLE_MINUTES=480
STUDENT_SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Student ID rule (applied to the upper-cased ID). Adjust to your school's real ID format.
STUDENT_ID_PATTERN=^[A-Z0-9][A-Z0-9_-]{2,31}$

# Login brute-force protection (per client IP)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
# General API rate limit (requests per minute per client IP)
API_RATE_LIMIT_PER_MINUTE=300
