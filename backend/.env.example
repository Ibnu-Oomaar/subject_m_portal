NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mathportal
DB_LOGGING=false
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
SESSION_COOKIE_NAME=mp_sid
COOKIE_SECURE=false
TEACHER_SESSION_IDLE_MINUTES=480
STUDENT_SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
STUDENT_ID_PATTERN=^[A-Z0-9][A-Z0-9_-]{2,31}$
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=300
